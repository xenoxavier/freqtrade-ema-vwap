{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 8,
    "stake_currency": "USDT",
    "stake_amount": 1.0,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "dry_run_wallet": 100,
    "cancel_open_orders_on_exit": false,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "timeframe": "1h",
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "gate",
        "key": "",
        "secret": "",
        "pair_whitelist": [],
        "pair_blacklist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT"
        ]
    },
    "pairlists": [
        {
            "method": "VolumePairList",
            "number_assets": 80,
            "sort_key": "quoteVolume",
            "min_value": 300000,
            "refresh_period": 1800
        },
        {
            "method": "AgeFilter",
            "min_days_listed": 3
        }
    ],
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8084,
        "verbosity": "error",
        "enable_openapi": true,
        "jwt_secret_key": "",
        "ws_token": "",
        "username": "freq",
        "password": ""
    },
    "bot_name": "ema-vwap-long",
    "initial_state": "running",
    "db_url": "sqlite:///user_data/tradesv3-emavwap.sqlite"
}
